# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET=""

# Öffentliche URL der App (ohne Slash am Ende).
# Pflicht hinter HTTPS-Reverse-Proxy/Tunnel: sonst landen OAuth-Redirects auf
# http://localhost:3000 und der Browser meldet TLS-Fehler bei https://localhost:3000.
# Muss zur Host-Teil von AUTH_TIKTOK_REDIRECT_URI passen (gleiche Origin).
AUTH_URL=""

# Next Auth Google Provider (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:password@localhost:5432/tiktok-automator"

# TikTok Login Kit (optional; ohne diese Variablen ist nur manuelles tok Account.connect nutzbar)
# App im Portal https://developers.tiktok.com anlegen → Client Key / Secret / Redirect URIs / Scopes setzen.
# TikTok fordert oft https:// für Redirect-URIs; lokal kann z. B. eine Tunnel-URL nötig sein.
AUTH_TIKTOK_CLIENT_KEY=""
AUTH_TIKTOK_CLIENT_SECRET=""
# Exakt diese URL auch im TikTok Portal eintragen, z.B. https://deine-domain.tld/api/auth/tiktok/callback
AUTH_TIKTOK_REDIRECT_URI=""
# z.B. user.info.basic,user.info.profile (vom Portal freigeschaltete Scopes,kommagetrennt)
AUTH_TIKTOK_SCOPES="user.info.basic,user.info.profile"
